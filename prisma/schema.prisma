generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum ProductStatus {
  ACTIVE
  DISCONTINUED
}

enum BatchStatus {
  ACTIVE
  DEPLETED
  EXPIRED
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
}

enum AuditAction {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED

  BATCH_CREATED
  BATCH_UPDATED
  BATCH_DELETED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  products     Product[]
  batches      Batch[]
  transactions InventoryTransaction[]
  audits       AuditLog[]
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  passwordHash   String
  role           UserRole @default(STAFF)
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id             String @id @default(cuid())
  organizationId String

  name          String
  sku           String
  purchasePrice Decimal
  sellingPrice  Decimal
  imageUrl      String?
  status        ProductStatus @default(ACTIVE)

  organization Organization @relation(fields: [organizationId], references: [id])
  batches      Batch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId, name])
}

model Batch {
  id             String @id @default(cuid())
  batchCode      String @unique
  organizationId String
  productId      String

  expiryDate DateTime?
  quantity   Int         @default(0)
  status     BatchStatus @default(ACTIVE)

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, productId])
  @@index([organizationId, status])
  @@index([productId, expiryDate])
}

model InventoryTransaction {
  id                String @id @default(cuid())
  transactionNumber String @unique

  organizationId String

  // Historical references only.
  // These are intentionally NOT foreign keys.
  productId String?
  batchId   String?
  userId    String?

  type     InventoryTransactionType
  quantity Int

  // Snapshots preserved even if Product or Batch is deleted.
  productName String
  sku         String
  batchCode   String?
  expiryDate  DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, productId])
  @@index([organizationId, batchId])
  @@index([organizationId, userId])
  @@index([organizationId, type])
}

model AuditLog {
  id          String @id @default(cuid())
  auditNumber String @unique

  organizationId String

  // Historical references only.
  // These are intentionally NOT foreign keys.
  productId String?
  batchId   String?
  userId    String?

  action AuditAction

  // Snapshots preserved for historical readability.
  productName String?
  sku         String?
  batchCode   String?
  quantity    Int?
  expiryDate  DateTime?

  details Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, productId])
  @@index([organizationId, batchId])
  @@index([organizationId, userId])
  @@index([organizationId, action])
}

model Sequence {
  key   String @id
  value Int    @default(0)
}
